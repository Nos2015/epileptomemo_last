{
  "name": "Angular Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Angular App",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm install",
  "postAttachCommand": {
    "server": "ng serve --host 0.0.0.0 --disable-host-check"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template"
      ]
    }
  }
}
